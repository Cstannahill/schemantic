{
  "name": "schemantic",
  "version": "0.3.0",
  "description": "A fully typed, extensible TypeScript type generator for FastAPI OpenAPI schemas",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "schemantic": "dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:release": "node scripts/run-release-tests.cjs",
    "verify:fixtures": "node scripts/ci/verify-fixtures.cjs",
    "verify:live": "node scripts/ci/verify-live.cjs",
    "package:verify": "node scripts/ci/verify-package.cjs",
    "release:prepare": "node scripts/release.cjs prepare",
    "release:check": "node scripts/release.cjs check",
    "release:notes": "node scripts/release.cjs notes",
    "lint": "eslint -c eslint.config.mjs src/**/*.ts",
    "lint:fix": "eslint -c eslint.config.mjs src/**/*.ts --fix",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run release:check && npm run lint && npm run test:release && npm test -- --runInBand",
    "publish:npm": "npm run release:check && npm publish --access public"
  },
  "keywords": [
    "typescript",
    "openapi",
    "fastapi",
    "api-client",
    "type-generation",
    "api",
    "codegen",
    "client-generator",
    "schema",
    "rest-api",
    "frontend",
    "backend",
    "full-stack",
    "react",
    "hooks",
    "json-schema",
    "developer-tools",
    "automation"
  ],
  "author": "Christian Tannahill <ctan.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cstannahill/schemantic.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Cstannahill/schemantic#readme",
  "bugs": {
    "url": "https://github.com/Cstannahill/schemantic/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^10.12.0",
    "jest": "^30.1.3",
    "js-yaml": "^4.3.2",
    "react": "^19.3.0",
    "react-test-renderer": "^19.3.0",
    "semver": "^7.8.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/**/*",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/__tests__/**"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "chokidar": "^4.0.1",
    "commander": "^14.0.1"
  }
}
