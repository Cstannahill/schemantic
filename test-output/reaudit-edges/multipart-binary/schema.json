{
  "openapi": "3.1.0",
  "info": {
    "title": "Edge API",
    "version": "1"
  },
  "paths": {
    "/upload": {
      "post": {
        "operationId": "upload",
        "responses": {
          "204": {
            "description": "ok"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Upload"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Upload": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary"
          }
        }
      }
    }
  }
}