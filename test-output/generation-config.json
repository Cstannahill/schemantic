{
  "generateTypes": true,
  "generateApiClient": true,
  "generateHooks": true,
  "generateQueries": false,
  "useStrictTypes": true,
  "useOptionalChaining": true,
  "useNullishCoalescing": true,
  "namingConvention": "camelCase",
  "preserveComments": true,
  "generateIndexFile": true,
  "generateBarrelExports": true,
  "schemaUrl": "test-output/image-conversion-schema-openapi.json",
  "outputDir": "test-output/generated",
  "typePrefix": "",
  "typeSuffix": "",
  "plugins": [
    { "name": "jsdoc", "enabled": true },
    { "name": "zod-validation", "enabled": true },
    { "name": "react-hooks", "enabled": true }
  ]
}
